# Configuración de APIs de IA
GEMINI_API_KEY="tu_api_key_de_gemini_aqui"
NVIDIA_API_KEY="tu_api_key_de_nvidia_aqui"

# Integración de Correos (opcional)
GMAIL_CREDENTIALS_PATH="./credentials.json"
# token.json will be created on first auth (desktop OAuth flow)

# === Scaling / Jobs (new) ===
# DATABASE_URL=postgresql://user:pass@localhost:5432/auditor   # or leave empty for SQLite
AUDITOR_STORAGE_DIR=storage
AUDITOR_LLM_MODE=none          # none | fallback | always   (strongly recommended "none" for mass jobs)
# CELERY_BROKER_URL=redis://localhost:6379/0

# === Object storage (MinIO / S3) when using minio backend ===
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=auditor-cotizaciones
# MINIO_SECURE=false

# Microsoft / Outlook (future)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
